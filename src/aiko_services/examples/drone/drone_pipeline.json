{
  "version": 0,
  "name": "p_drone",
  "runtime": "python",
  "graph": [
    "(ImageReadDroneXR872 ImageConvert YoloDetector ImageOverlay VideoShow)",
    "(ControlReadJoystick FlightWriteDroneXR872)"
  ],
  "elements": [
    {
      "name": "ControlReadJoystick",
      "parameters": {
        "roll_axis": null, "pitch_axis": null, "yaw_axis": null, "throttle_axis": null,
        "takeoff_button": null, "land_button": null, "emergency_button": null,
        "invert_pitch": null, "invert_yaw": null, "invert_throttle": null,
        "deadzone": null, "expo": null,
        "max_roll": null, "max_pitch": null, "max_yaw": null, "max_throttle": null
      },
      "input": [
        {"name": "control_input", "type": "control_input"},
        {"name": "requested_action", "type": "string"}
      ],
      "output": [
        {"name": "control_input", "type": "control_input"},
        {"name": "requested_action", "type": "string"}
      ],
      "deploy": {
        "local": {"module": "aiko_services.examples.drone.controller_input"}
      }
    },
    {
      "name": "FlightWriteDroneXR872",
      "parameters": {"device_ip": "192.168.28.1", "rxtx_port": 7080},
      "input": [
        {"name": "control_input", "type": "control_input"},
        {"name": "requested_action", "type": "string"}
      ],
      "output": [],
      "deploy": {
        "local": {"module": "aiko_services.examples.drone.drone_control"}
      }
    },
    {
      "name": "ImageReadDroneXR872",
      "parameters": {
        "device_ip": "192.168.28.1",
        "video_port": 7070,
        "rxtx_port": 7080,
        "data_batch_size": 1
      },
      "input": [{"name": "records", "type": "[bytes]"}],
      "output": [{"name": "images", "type": "[image]"}],
      "deploy": {
        "local": {"module": "aiko_services.examples.drone.drone_video"}
      }
    },
    {
      "name": "VideoShow",
      "input": [{"name": "images", "type": "[image]"}],
      "output": [],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.video_io"}
      }
    },
    { "name": "ImageConvert",
      "parameters": {"media_type": "numpy"},
      "input":  [{"name": "images", "type": "[image]"}],
      "output": [{"name": "overlay", "type": "[overlay]"}],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.image_io"}
      }
    },
    { "name":   "YoloDetector",
      "parameters": {
        "model": "yoloe-11s-seg.pt",  "#": "model sizes: yoloe-11[sml]-seg.pt",
        "names": "(ball book cat dog glasses lightbulb mug person)"
      },
      "input":  [{"name": "images",  "type": "[image]"}],
      "output": [{"name": "overlay", "type": "[overlay]"}],
      "deploy": {
        "local": {"module": "aiko_services.examples.yolo.yolo"}
      }
    },
    { "name":   "ImageOverlay",
      "input":  [{"name": "images",  "type": "[image]"},
                 {"name": "overlay", "type": "[overlay]"}],
      "output": [{"name": "images",  "type": "[image]"}],
      "deploy": {
        "local": {"module": "aiko_services.elements.media.image_io"}
      }
    }
  ]
}
